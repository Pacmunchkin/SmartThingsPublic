[resource]
script = ExtResource("1_mission")
mission_id = &"m04_athelney"
title = "The Causeway at Æthelinga Īeg"
subtitle = "Somerset Levels, February 878"
briefing = "You are Wulfstan, thegn of Ēastburh, and you have forty-one men.\n\nGuthrum's host took Chippenham at Twelfth Night while the kingdom was drunk. Alfred is somewhere in the marsh with a household guard and no army. What he has instead is time - and time is bought at crossings like this one.\n\nA raiding band has come up the river to burn the minster and cut the causeway to the island. Hold it long enough for the fyrd of Somerset to reach you, then put the raiders back in the water."
historical_note = "Athelney, Alfred's marsh refuge in the winter of 877-878, is attested; the Ēastburh of this mission is not. Jarl Sigurð Ormsson is invented. The Danish practice of overwintering, raiding upriver by ship and beaching for a land action is well recorded, as is the fyrd's slow, obligation-bound muster - which is why the reinforcement trickle in Act II is a trickle."
level_scene = "res://missions/m04_athelney/m04_the_causeway_at_athelney.tscn"
acts = Array[Resource]([SubResource("Resource_act1"), SubResource("Resource_act2"), SubResource("Resource_act3")])
squad_library = Array[Resource]([ExtResource("6_thegn"), ExtResource("7_hearth"), ExtResource("8_spear"), ExtResource("9_bow"), ExtResource("10_cart"), ExtResource("11_bondi"), ExtResource("12_huscarl"), ExtResource("13_dbow"), ExtResource("14_berserkr"), ExtResource("15_jarl")])
protected_units = Array[StringName]([&"sax_thegn_wulfstan"])
critical_sectors = Array[StringName]([&"sector_minster"])
critical_sector_grace_seconds = 75.0
fail_if_all_squads_lost = true
