[sub_resource type="Resource" id="Resource_a1o1"]
script = ExtResource("3_obj")
objective_id = &"obj_escort_cart"
title = "Get the cart across the causeway"
description = "The minster's relics and the children of Ēastburh are on one ox-cart. It moves at a walk, it cannot leave the road, and it will not survive being caught in the open."
kind = 3
priority = 0
target_unit = &"obj_ox_cart"
target_marker = &"P_EvacGoal"
required_count = 1
duration_seconds = 0.0
grace_seconds = 0.0
starts_hidden = false
completion_wave_scalar = 1.0

