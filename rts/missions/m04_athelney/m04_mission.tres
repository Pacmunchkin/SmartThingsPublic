[sub_resource type="Resource" id="Resource_act1"]
script = ExtResource("2_act")
act_id = &"act_1_crossing"
title = "I - The Loading of the Cart"
briefing = "Ēastburh, in the Somerset Levels. A month after the heathen took Chippenham at Twelfth Night, and three days after the last of Wessex's ealdormen sent word that he would not come.\n\nGet the minster's cart onto the causeway. Everything after that is a fight you chose."
outro = "The cart is on the far bank. Now the harder half."
objectives = Array[Resource]([SubResource("Resource_a1o1"), SubResource("Resource_a1o2"), SubResource("Resource_a1o3")])
waves = Array[Resource]([SubResource("Resource_a1w1"), SubResource("Resource_a1w2"), SubResource("Resource_a1w3")])
scripted_events = Array[Resource]([SubResource("Resource_a1e1"), SubResource("Resource_a1e2"), SubResource("Resource_a1e3"), SubResource("Resource_a1e4")])
deploy_spawn_markers = Array[StringName]([&"P_Thegn", &"P_Hearthweru", &"P_FyrdSpear_A", &"P_FyrdSpear_B", &"P_FyrdBow", &"P_EscortCart"])
advance = 0
advance_objective = &"obj_escort_cart"
reinforcement_interval = 0.0

[sub_resource type="Resource" id="Resource_act2"]
script = ExtResource("2_act")
act_id = &"act_2_shieldwall"
title = "II - The Shieldwall at Ēastburh"
briefing = "Seven minutes until Somerset comes up the drove road. Hold the rise."
outro = "Horns on the causeway. Ours."
objectives = Array[Resource]([SubResource("Resource_a2o1"), SubResource("Resource_a2o2"), SubResource("Resource_a2o3"), SubResource("Resource_a2o4")])
waves = Array[Resource]([SubResource("Resource_a2w1"), SubResource("Resource_a2w2"), SubResource("Resource_a2w3"), SubResource("Resource_a2w4"), SubResource("Resource_a2w5"), SubResource("Resource_a2w6"), SubResource("Resource_a2w7")])
scripted_events = Array[Resource]([SubResource("Resource_a2e1"), SubResource("Resource_a2e2"), SubResource("Resource_a2e3"), SubResource("Resource_a2e4"), SubResource("Resource_a2e5"), SubResource("Resource_a2e6"), SubResource("Resource_a2e7"), SubResource("Resource_a2e8")])
deploy_spawn_markers = Array[StringName]([])
advance = 2
advance_sector = &"sector_minster"
advance_seconds = 420.0
reinforcement_interval = 90.0
reinforcement_squad_id = &"sax_fyrd_spear"
